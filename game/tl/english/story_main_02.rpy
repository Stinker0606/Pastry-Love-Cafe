    m "\"Then I don't want breakfast.\""

# game/story_main_02.rpy:206
translate english story_intro_02_ceceb0d2:

    # user "Unangenehm schaute ich mich im Zimmer um."
    user "Awkwardly, I looked around the room."

# game/story_main_02.rpy:208
translate english story_intro_02_b7cda19a:

    # user "\"Also, ich hoffe ihr seid heute bereit und motiviert euren ersten Tag nach dem training anzugehen?\""
    user "\"So, I hope you're all ready and motivated to tackle your first day after training today?\""

# game/story_main_02.rpy:214
translate english story_intro_02_3eba9ad2:

    # user "Jeder von ihnen hatte einen nicht so glücklichen Gesichtsausdruck."
    user "Each of them had a less-than-happy expression on their face."

# game/story_main_02.rpy:227
translate english story_intro_02_afce0b33:

    # user "Ich drehte mich zu Velvette, die immer noch kritisch ihren teigfreien Teller anstarrte."
    user "I turned to Velvette, who was still critically staring at her dough-free plate."

