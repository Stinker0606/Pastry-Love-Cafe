    m "\"I want to sleep.\""

# game/story_main_02.rpy:202
translate english story_intro_02_61cc643b:

    # user "\"Das ist kein Frühstück.\""
    user "\"That's not breakfast.\""

# game/story_main_02.rpy:204
translate english story_intro_02_1c51fb72:

