# game/story_main_02.rpy:148
translate english story_intro_02_41368f91:

    # user "\"Und außerdem: Es gibt keine 'zu fluffigen' Pfannkuchen. Das sieht köstlich aus, Cino.\""
    user "\"And besides: there's no such thing as 'too fluffy' pancakes. This looks delicious, Cino.\""

# game/story_main_02.rpy:152
translate english story_intro_02_ac359966:

    # user "Cinos Augen leuchteten auf, als hätte ich ihm gerade den Nobelpreis verliehen."
    user "Cino's eyes lit up as if I had just awarded him the Nobel Prize."

# game/story_main_02.rpy:154
translate english story_intro_02_34fb394a:

