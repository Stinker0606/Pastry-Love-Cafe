translate english story_intro_02_aa770b5f:

    # c "\"Ich habe uns Pfannkuchen gemacht! Ich hoffe, sie sind nicht zu fluffig, ich wollte sie besonders fluffig machen, aber dann waren sie… zu fluffig, also-\""
    c "\"I made us pancakes! I hope they're not too fluffy, I wanted to make them extra fluffy, but then they were... too fluffy, so-\""

# game/story_main_02.rpy:109
translate english story_intro_02_8ed9c6b4:

    # l "\"CINO, KEINER BRAUCHT EINEN ESSAY ÜBER PANCAKES!!\""
    l "\"CINO, NO ONE NEEDS AN ESSAY ON PANCAKES!!\""

# game/story_main_02.rpy:111
translate english story_intro_02_865c9431:

    # user "Fauchte Lavan und riss ihm fast den Teller aus der Hand."
    user "Lavan hissed and almost snatched the plate out of his hand."

