# game/story_main_03.rpy:5
translate english story_intro_03_a1bf999d:

    # user "Der Wecker klingelte. Ein neuer Tag."
    user "The alarm rang. A new day."

# game/story_main_03.rpy:23
translate english story_intro_03_0b269936:

    # user "Ich streckte mich ausgiebig. Als ich die Augen öffnete, fühlte sich das Zimmer heller an als sonst."
    user "I stretched extensively. When I opened my eyes, the room felt brighter than usual."

# game/story_main_03.rpy:24
translate english story_intro_03_faf57a0f:

    # user "Gestern lief es eigentlich ziemlich gut. Besser als erwartet."
    user "Yesterday actually went pretty well. Better than expected."

# game/story_main_03.rpy:25
translate english story_intro_03_6e978961:

    # user "Auch wenn es kleine Probleme gab, haben wir sie schnell gelöst."
    user "Even though there were small problems, we solved them quickly."

# game/story_main_03.rpy:26
translate english story_intro_03_eb9e5e55:

    # user "Der Laden lief, die Kasse stimmte und das Wichtigste wir haben uns nicht gegenseitig umgebracht."
    user "The shop ran smoothly, the cash register was correct, and most importantly, we didn't kill each other."

# game/story_main_03.rpy:30
translate english story_intro_03_9fe10849:

    # user "Mein Wecker riss mich aus einem unruhigen Schlaf. Ich rieb mir die Schläfen."
    user "My alarm jolted me out of a restless sleep. I rubbed my temples."

# game/story_main_03.rpy:31
translate english story_intro_03_a390d0e8:

    # user "Gestern war... okay. Es gab Höhen und Tiefen."
    user "Yesterday was... okay. There were ups and downs."

# game/story_main_03.rpy:32
translate english story_intro_03_3ef691f7:

    # user "Wir haben überlebt, aber 'harmonisch' ist ein Wort, das ich noch nicht benutzen würde."
    user "We survived, but 'harmonious' is a word I wouldn't use just yet."

# game/story_main_03.rpy:33
translate english story_intro_03_b825db53:

    # user "Wir müssten mehr an unserem Zusammenhalt arbeiten. Vielleicht eine Gruppenübung oder der gleichen"
    user "We need to work more on our cohesion. Maybe a group exercise or something like that."

# game/story_main_03.rpy:37
translate english story_intro_03_8ff1bc33:

    # user "Als der Wecker klingelte konnte ich nur grummeln."
    user "When the alarm rang, all I could do was grumble."

# game/story_main_03.rpy:38
translate english story_intro_03_a3e71cff:

    # user "Ich zog die Decke über den Kopf und wollte gar nicht aufstehen."
    user "I pulled the blanket over my head, not wanting to get up at all."

# game/story_main_03.rpy:39
translate english story_intro_03_74c97925:

    # user "Gestern war eine absolute Katastrophe."
    user "Yesterday was an absolute disaster."

# game/story_main_03.rpy:40
translate english story_intro_03_3ea44a74:

    # user "Das pure Chaos. Wenn ich daran denke, zieht sich mein Magen zusammen."
    user "Pure chaos. When I think about it, my stomach ties in knots."

# game/story_main_03.rpy:41
translate english story_intro_03_03e7abf3:

    # user "Ich weiß wirklich nicht wie ich das verbessern sollte."
    user "I really don't know how I'm supposed to improve this."

# game/story_main_03.rpy:46
translate english story_intro_03_3f4e2938:

    # user "Während ich mich anzog, gingen mir die Gesichter von gestern durch den Kopf..."
    user "While I was getting dressed, the faces from yesterday went through my head..."

# game/story_main_03.rpy:55
translate english story_intro_03_019c1c8d:

    # user "Lavan war den ganzen Tag wütend, weil ich ihn wie ein Kind behandelt habe."
    user "Lavan was angry all day because I treated him like a child."

# game/story_main_03.rpy:59
translate english story_intro_03_58025123:

    # user "Und die arme Espressomaschine... Lavan hat sie fast verprügelt."
    user "And the poor espresso machine... Lavan almost beat it up."

# game/story_main_03.rpy:60
translate english story_intro_03_95aeb6ad:

    # user "Er war so gestresst, dass der halbe Kaffee daneben ging, aber niemand hatte auch Zeit ihm zu helfen."
    user "He was so stressed out that half the coffee spilled, but no one had the time to help him either."

# game/story_main_03.rpy:64
translate english story_intro_03_e6ceee24:

    # user "Nachdem er seine Wut runtergeschluckt hatte, war er wiklich professionell."
    user "After he swallowed his anger, he was really professional."

# game/story_main_03.rpy:70
translate english story_intro_03_f98a4352:

    # user "Macoi war nach meiner Ansage völlig durch den Wind."
    user "Macoi was completely thrown off after my announcement."

# game/story_main_03.rpy:71
translate english story_intro_03_3e0c2ad0:

    # user "Er hat sich komplett abgekapselt."
    user "He completely isolated himself."

# game/story_main_03.rpy:75
translate english story_intro_03_5034cf6e:

    # user "Bei Macoi hat das System komplett ausgesetzt."
    user "Macoi's system completely crashed."

# game/story_main_03.rpy:76
translate english story_intro_03_d85d0508:

    # user "Er hat bestimmt drei Bestellungen falsch aufgenommen, weil er im Halbschlaf war und ich ihn nicht wachgerüttelt habe."
    user "He probably took three orders wrong because he was half asleep and I didn't shake him awake."

# game/story_main_03.rpy:80
translate english story_intro_03_3375b660:

    # user "Er war überraschend wach und konzentriert. Hat er vielleicht Übung in Cooking Mama?"
    user "He was surprisingly awake and focused. Does he maybe have practice in Cooking Mama?"

# game/story_main_03.rpy:86
translate english story_intro_03_d789e481:

    # user "Velvette war zickig zu den Kunden, nachdem ich sie vor allen bloßgestellt habe."
    user "Velvette was bitchy to the customers after I exposed her in front of everyone."

# game/story_main_03.rpy:90
translate english story_intro_03_d9a81f66:

    # user "Es gab Beschwerden über eine 'arrogante Kellnerin'. Ich hätte bei Velvette eingreifen sollen."
    user "There were complaints about an 'arrogant waitress'. I should have intervened with Velvette."

# game/story_main_03.rpy:94
translate english story_intro_03_bb967737:

    # user "Velvette war der Wahnsinn, ich konnte garnicht ahnen das sie so ein Naturtalent ist."
    user "Velvette was amazing, I had no idea she was such a natural talent."

# game/story_main_03.rpy:100
translate english story_intro_03_a5bbd8f7:

    # user "Und überall lagen zerrissene Servietten herum..cino."
    user "And torn napkins were lying around everywhere... Cino."

# game/story_main_03.rpy:104
translate english story_intro_03_f20d8296:

    # user "Er sah so verloren aus, wie ein zurückgelassener Welpe."
    user "He looked so lost, like an abandoned puppy."

# game/story_main_03.rpy:108
translate english story_intro_03_75cc4303:

    # user "Er war wirklich beliebt bei den Kunden, sehr nett, die Leute lieben ihn."
    user "He was really popular with the customers, very nice, people love him."

# game/story_main_03.rpy:124
translate english story_intro_03_fec8612a:

    # user "Aber egal. Heute ist ein neuer Tag. Hoffentlich läuft es heute genauso gut."
    user "But whatever. Today is a new day. Hopefully, it goes just as well today."

# game/story_main_03.rpy:125
translate english story_intro_03_c6b6d0a3:

    # user "Ich öffnete die Tür und hüpfte die Treppe fast schon hinunter. Es roch lecker nach Kaffee."
    user "I opened the door and practically skipped down the stairs. It smelled deliciously like coffee."

# game/story_main_03.rpy:129
translate english story_intro_03_c80f6716:

    # user "Ich seufzte. Ich muss das heute besser machen. Ein bisschen mehr Struktur würde uns gut tun."
    user "I sighed. I need to do better today. A little more structure would do us good."

# game/story_main_03.rpy:130
translate english story_intro_03_c824b899:

    # user "Ich schlurfte die Treppe hinunter. Hoffentlich ist noch Kaffee übrig."
    user "I shuffled down the stairs. Hopefully there's still some coffee left."

# game/story_main_03.rpy:134
translate english story_intro_03_fe7dd4e1:

    # user "Ich muss das heute retten. Dringend."
    user "I have to save this today. Urgently."

# game/story_main_03.rpy:135
translate english story_intro_03_df018f13:

    # user "Mit einem flauen Gefühl im Magen ging ich langsam die Treppe hinunter, als würde ich zum Hinrichtung gehen."
    user "With a sinking feeling in my stomach, I walked slowly down the stairs, as if going to an execution."

# game/story_main_03.rpy:143
translate english story_intro_03_019b3760:

    # user "Als ich die Küche betrat, saßen alle schon am Tisch."
    user "When I entered the kitchen, everyone was already sitting at the table."

# game/story_main_03.rpy:149
translate english story_intro_03_cf083c5d:

    # user "Die Stimmung war entspannt. Cino summte, Lavan wirkte konzentriert und selbst Velvette nickte mir zu."
    user "The mood was relaxed. Cino hummed, Lavan seemed focused, and even Velvette nodded at me."

# game/story_main_03.rpy:150
translate english story_intro_03_f88a20ee:

    # user "\"Morgen, Team!\""
    user "\"Morning, team!\""

# game/story_main_03.rpy:151
translate english story_intro_03_7a4ea627:

    # c "\"Guten Morgen, [player_name]! Wir sind bereit für Runde zwei!\""
    c "\"Good morning, [player_name]! We're ready for round two!\""

# game/story_main_03.rpy:152
translate english story_intro_03_921a8563:

    # l "\"Pff. Ich bin immer bereit.\""
    l "\"Pfft. I'm always ready.\""

# game/story_main_03.rpy:158
translate english story_intro_03_1dd72870:

    # user "Es war still. Man hörte nur das Klappern von Löffeln. Die Anspannung von gestern hing noch leicht in der Luft."
    user "It was quiet. You could only hear the clinking of spoons. The tension from yesterday still lingered slightly in the air."

# game/story_main_03.rpy:159
translate english story_intro_03_a8974438:

    # user "\"Morgen.\""
    user "\"Morning.\""

# game/story_main_03.rpy:160
translate english story_intro_03_afa641a9:

    # m "\"Mhm...\""
    m "\"Mhm...\""

# game/story_main_03.rpy:161
translate english story_intro_03_04d53fcd:

    # v "\"Ich hoffe, du hast heute einen besseren Plan als gestern.\""
    v "\"I hope you have a better plan today than yesterday.\""

# game/story_main_03.rpy:162
translate english story_intro_03_6e7916aa:

    # user "\"Wir kriegen das hin.\""
    user "\"We'll manage.\""

# game/story_main_03.rpy:169
translate english story_intro_03_7f16c6e5:

    # user "Die Luft war zum Schneiden dick. Lavan funkelte mich an, Velvette drehte sich weg."
    user "The tension was thick enough to cut. Lavan glared at me, Velvette turned away."

# game/story_main_03.rpy:170
translate english story_intro_03_d4751b4f:

    # user "\"Guten Morgen...\" versuchte ich es vorsichtig."
    user "\"Good morning...\" I tried cautiously."

# game/story_main_03.rpy:172
translate english story_intro_03_de8c17ea:

    # v "\"Spar dir das. Mein Kopf tut weh von dem Lärm gestern.\""
    v "\"Save it. My head hurts from the noise yesterday.\""

# game/story_main_03.rpy:173
translate english story_intro_03_b882372e:

    # l "\"Wenn das heute wieder so läuft, explodiert hier nicht nur die Kaffeemaschine.\""
    l "\"If it goes like this again today, the coffee machine won't be the only thing exploding around here.\""

# game/story_main_03.rpy:174
translate english story_intro_03_43e8f230:

    # user "Okay... das wird hart."
    user "Okay... this is going to be tough."

# game/story_main_03.rpy:185
translate english story_intro_03_2fdcc5fd:

    # user "Ich räusperte mich, um ihre Aufmerksamkeit zu bekommen."
    user "I cleared my throat to get their attention."

# game/story_main_03.rpy:192
translate english story_intro_03_149744cd:

    # user "\"Hört zu. Morgen ist Wochenende. Das bedeutet, heute machen wir nur eine kurze Schicht bis 14 Uhr.\""
    user "\"Listen up. Tomorrow is the weekend. That means we're only doing a short shift until 2 PM today.\""

# game/story_main_03.rpy:196
translate english story_intro_03_ef366103:

    # user "\"Und weil ihr gestern so einen tollen Job gemacht habt, habe ich eine Belohnung geplant.\""
    user "\"And because you did such a great job yesterday, I've planned a reward.\""

# game/story_main_03.rpy:197
translate english story_intro_03_982e1e6e:

    # user "\"Wir gehen danach alle zusammen ins Einkaufszentrum. Shoppen, Essen, Spaß haben. Auf meine Kosten.\""
    user "\"We're all going to the mall together afterwards. Shopping, eating, having fun. My treat.\""

# game/story_main_03.rpy:199
translate english story_intro_03_1139c68d:

    # c "\"Jaaaa! Shoppen!\""
    c "\"Yeees! Shopping!\""

# game/story_main_03.rpy:201
translate english story_intro_03_189947c1:

    # v "\"Endlich eine vernünftige Entscheidung. Ich brauche dringend neue Ohrringe.\""
    v "\"Finally a sensible decision. I desperately need new earrings.\""

# game/story_main_03.rpy:205
translate english story_intro_03_afefedba:

    # user "\"Danach gehen wir ins Einkaufszentrum. Wir müssen alle mal rauskommen und den Kopf freikriegen.\""
    user "\"Afterwards we're going to the mall. We all need to get out and clear our heads.\""

# game/story_main_03.rpy:206
translate english story_intro_03_393532bb:

    # user "\"Ich lade euch auf ein Essen ein. Ein bisschen Entspannung tut uns gut. Und vorallem stärkt es unseren Teamgeist.\""
    user "\"I'm treating you to a meal. A little relaxation will do us good. And most importantly, it'll strengthen our team spirit.\""

# game/story_main_03.rpy:208
translate english story_intro_03_1efe77e7:

    # m "\"Essen klingt gut...\""
    m "\"Food sounds good...\""

# game/story_main_03.rpy:209
translate english story_intro_03_0033497c:

    # l "\"Von mir aus. Besser als hier rumzuhocken.\""
    l "\"Fine by me. Better than sitting around here.\""

# game/story_main_03.rpy:213
translate english story_intro_03_35d2b614:

    # user "\"Und da gestern... nun ja... optimierungsbedürftig war, ist das heute Pflichtprogramm.\""
    user "\"And since yesterday was... well... in need of optimization, this is mandatory today.\""

# game/story_main_03.rpy:214
translate english story_intro_03_74b89399:

    # user "\"Wir gehen ins Einkaufszentrum. Teambuilding. Wir müssen lernen, miteinander klarzukommen, ohne, dass der Laden abbrennt.\""
    user "\"We're going to the mall. Team building. We have to learn to get along without the shop burning down.\""

# game/story_main_03.rpy:216
translate english story_intro_03_9061fd9a:

    # l "\"Teambuilding? Dein Ernst?\""
    l "\"Team building? Are you serious?\""

# game/story_main_03.rpy:217
translate english story_intro_03_26a5940e:

    # user "\"Ja, mein Ernst. Keine Widerrede. Wir müssen ein Team werden.\""
    user "\"Yes, I'm serious. No arguments. We need to become a team.\""

# game/story_main_03.rpy:218
translate english story_intro_03_0ee1daf8:

    # user "\"Außerdem müssen wir ein paar Sachen holen UND ihr könnt auch sehen wie andere in eurem Feld sich bei Kunden verhalten.\""
    user "\"Besides, we need to pick up a few things AND you can also see how others in your field behave with customers.\""

# game/story_main_03.rpy:219
translate english story_intro_03_329572ea:

    # user "\"Nimmt es als eine Art Übung auf.\""
    user "\"Take it as a sort of exercise.\""
    