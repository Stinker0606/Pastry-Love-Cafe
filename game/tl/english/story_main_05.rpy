# game/story_main_05.rpy:12
translate english act5_daydreaming_and_decision_d9374048:

    # user "Der nächste Arbeitstag hatte längst begonnen, aber mein Kopf war ganz woanders."
    user "The next workday had long since begun, but my head was completely somewhere else."

# game/story_main_05.rpy:14
translate english act5_daydreaming_and_decision_979dee10:

    # user "Ich wischte mechanisch über den Tresen, während meine Gedanken immer wieder zum gestrigen Abend im Einkaufszentrum zurückwanderten."
    user "I wiped the counter mechanically while my thoughts kept wandering back to yesterday evening at the mall."

# game/story_main_05.rpy:16
translate english act5_daydreaming_and_decision_397fb02a:

    # user "Das Lachen, die Atmosphäre, dieser eine Moment..."
    user "The laughter, the atmosphere, that one moment..."

# game/story_main_05.rpy:18
translate english act5_daydreaming_and_decision_9f01f17d:

    # user "Ich muss wohl ziemlich abwesend ausgesehen haben, denn plötzlich riss mich eine Stimme aus meinen Gedanken."
    user "I must have looked pretty absent-minded, because suddenly a voice snapped me out of my thoughts."

# game/story_main_05.rpy:45
translate english act5_daydreaming_and_decision_9c1fee96:

    # l "\"Hey! Hallo?! Erde an [player_name]!\""
    l "\"Hey! Hello?! Earth to [player_name]!\""

# game/story_main_05.rpy:46
translate english act5_daydreaming_and_decision_675a0dd3:

    # user "Ich zuckte zusammen. Lavan stand direkt vor mir, die Arme verschränkt, die Stirn in Falten."
    user "I flinched. Lavan stood directly in front of me, arms crossed, forehead wrinkled."

# game/story_main_05.rpy:47
translate english act5_daydreaming_and_decision_ea422972:

    # user "\"Lavan? Was ist los? Brennt was?\""
    user "\"Lavan? What's wrong? Is something on fire?\""

# game/story_main_05.rpy:48
translate english act5_daydreaming_and_decision_a4eda3e4:

    # l "\"Nein. Aber du starrst seit fünf Minuten die Kaffeemühle an, als würdest du sie hypnotisieren wollen.\""
    l "\"No. But you've been staring at the coffee grinder for five minutes as if you want to hypnotize it.\""

# game/story_main_05.rpy:49
translate english act5_daydreaming_and_decision_0e237070:

    # user "Er sah zur Seite, seine Stimme wurde etwas leiser, fast nuschelnd."
    user "He looked away, his voice getting a bit quieter, almost mumbling."

# game/story_main_05.rpy:51
translate english act5_daydreaming_and_decision_387b325c:

    # l "\"Du... wirkst nicht ganz da. Bist du krank? Oder hast du gestern zu viel Unsinn gegessen?\""
    l "\"You... don't seem quite there. Are you sick? Or did you eat too much junk yesterday?\""

# game/story_main_05.rpy:52
translate english act5_daydreaming_and_decision_6f069a88:

    # user "\"Mir geht's gut, Lavan. Ich habe nur nachgedacht.\""
    user "\"I'm fine, Lavan. I was just thinking.\""

# game/story_main_05.rpy:54
translate english act5_daydreaming_and_decision_af94f886:

    # l "\"Tsk. Dann denk gefälligst an die Arbeit. Ich brauche dich hier fit. Verstanden?\""
    l "\"Tsk. Then kindly think about work. I need you focused here. Understood?\""

# game/story_main_05.rpy:55
translate english act5_daydreaming_and_decision_9a99b72e:

    # user "Trotz der harschen Worte blieb er noch einen Moment stehen und musterte mich besorgt, bevor er zurück zur Maschine ging."
    user "Despite the harsh words, he stood there for another moment, eyeing me with concern, before heading back to the machine."

# game/story_main_05.rpy:60
translate english act5_daydreaming_and_decision_11006f9d:

    # user "Ein Schnippen vor meinen Augen holte mich zurück in die Realität."
    user "A snap in front of my eyes brought me back to reality."

# game/story_main_05.rpy:62
translate english act5_daydreaming_and_decision_bc8901af:

    # v "\"Darling? Bist du eingefroren? Das steht dir nicht.\""
    v "\"Darling? Are you frozen? It doesn't suit you.\""

# game/story_main_05.rpy:63
translate english act5_daydreaming_and_decision_93017f9f:

    # user "Velvette lehnte elegant am Tresen und musterte mich mit kritischem, aber aufmerksamem Blick."
    user "Velvette leaned elegantly against the counter and scrutinized me with a critical but attentive gaze."

# game/story_main_05.rpy:64
translate english act5_daydreaming_and_decision_54d6082d:

    # user "\"Oh. Sorry, Velvette. Ich war in Gedanken.\""
    user "\"Oh. Sorry, Velvette. I was lost in thought.\""

# game/story_main_05.rpy:66
translate english act5_daydreaming_and_decision_44fc3a88:

    # v "\"Offensichtlich. Deine Aura ist völlig zerstreut. Es ist der Ausflug gestern, nicht wahr?\""
    v "\"Obviously. Your aura is completely scattered. It's the trip from yesterday, isn't it?\""

# game/story_main_05.rpy:67
translate english act5_daydreaming_and_decision_6c12960f:

    # user "Sie lächelte leicht, fast wissend."
    user "She smiled slightly, almost knowingly."

# game/story_main_05.rpy:68
translate english act5_daydreaming_and_decision_73f2c786:

    # v "\"Hat dich meine Gesellschaft so sehr beeindruckt, dass du jetzt zu keiner kognitiven Leistung mehr fähig bist?\""
    v "\"Did my company impress you so much that you are now incapable of any cognitive performance?\""

# game/story_main_05.rpy:69
translate english act5_daydreaming_and_decision_01b0bf95:

    # user "\"Vielleicht ein bisschen.\""
    user "\"Maybe a little bit.\""

# game/story_main_05.rpy:71
translate english act5_daydreaming_and_decision_4eb71dd3:

    # v "\"Verständlich. Ruh dich aus, wenn du musst. Ich kann es nicht gebrauchen, wenn mein Personal Augenringe bekommt.\""
    v "\"Understandable. Rest if you must. I can't have my staff getting bags under their eyes.\""

# game/story_main_05.rpy:76
translate english act5_daydreaming_and_decision_6815c6b2:

    # user "Plötzlich spürte ich eine Hand auf meiner Stirn."
    user "Suddenly I felt a hand on my forehead."

# game/story_main_05.rpy:78
translate english act5_daydreaming_and_decision_c5001c79:

    # c "\"Hmm... kein Fieber. Aber du guckst so glasig!\""
    c "\"Hmm... no fever. But you look so glassy!\""

# game/story_main_05.rpy:79
translate english act5_daydreaming_and_decision_476d0df7:

    # user "Cino stand vor mir, die Augen groß vor Sorge. Er hielt einen halb aufgegessenen Keks in der anderen Hand."
    user "Cino stood in front of me, eyes wide with worry. He held a half-eaten cookie in his other hand."

# game/story_main_05.rpy:80
translate english act5_daydreaming_and_decision_8934dcce:

    # user "\"Cino? Alles okay?\""
    user "\"Cino? Everything okay?\""

# game/story_main_05.rpy:82
translate english act5_daydreaming_and_decision_102ea5d6:

    # c "\"Das frage ich dich! Du hast den Kunden gar nicht gehört! Geht es dir gut? Bist du traurig?\""
    c "\"I should be asking you! You didn't even hear the customer! Are you okay? Are you sad?\""

# game/story_main_05.rpy:83
translate english act5_daydreaming_and_decision_af4d3fd3:

    # user "\"Nein, gar nicht. Ich bin nur etwas... verträumt.\""
    user "\"No, not at all. I'm just a bit... dreamy.\""

# game/story_main_05.rpy:84
translate english act5_daydreaming_and_decision_e8702eae:

    # c "\"Oh! Verträumt ist gut! Aber mach mir keine Angst, okay?\""
    c "\"Oh! Dreamy is good! But don't scare me, okay?\""

# game/story_main_05.rpy:85
translate english act5_daydreaming_and_decision_978cd5db:

    # user "Er brach ein Stück von seinem Keks ab und hielt es mir hin."
    user "He broke off a piece of his cookie and held it out to me."

# game/story_main_05.rpy:87
translate english act5_daydreaming_and_decision_04c4a3b5:

    # c "\"Hier. Zucker hilft beim Denken!\""
    c "\"Here. Sugar helps you think!\""

# game/story_main_05.rpy:92
translate english act5_daydreaming_and_decision_589d9a90:

    # user "Jemand tippte mir leicht gegen den Ellbogen."
    user "Someone tapped my elbow lightly."

# game/story_main_05.rpy:93
translate english act5_daydreaming_and_decision_c722aa9e:

    # user "Ich drehte mich um. Macoi stand da, leise wie immer."
    user "I turned around. Macoi stood there, quiet as always."

# game/story_main_05.rpy:95
translate english act5_daydreaming_and_decision_e908b984:

    # m "\"Lag?\""
    m "\"Lag?\""

# game/story_main_05.rpy:96
translate english act5_daydreaming_and_decision_f0953173:

    # user "\"Was?\""
    user "\"What?\""

# game/story_main_05.rpy:97
translate english act5_daydreaming_and_decision_afad3cf0:

    # m "\"Du hast gelaggt. Standbild. Seit zwei Minuten.\""
    m "\"You lagged. Frozen screen. For two minutes.\""

# game/story_main_05.rpy:98
translate english act5_daydreaming_and_decision_e921ef85:

    # user "Er musterte mich aus seinen halb geschlossenen Augen. Er wirkte nicht genervt, eher... beobachtend."
    user "He watched me through his half-closed eyes. He didn't seem annoyed, more like... observant."

# game/story_main_05.rpy:99
translate english act5_daydreaming_and_decision_945d0baa:

    # user "\"Ja... sorry. Mein System muss wohl noch laden.\""
    user "\"Yeah... sorry. My system must still be loading.\""

# game/story_main_05.rpy:100
translate english act5_daydreaming_and_decision_4b2afc5a:

    # m "\"Verstehe. Zu viele Hintergrundprozesse vom Wochenende.\""
    m "\"I see. Too many background processes from the weekend.\""

# game/story_main_05.rpy:102
translate english act5_daydreaming_and_decision_af6f77f1:

    # user "Er schob mir stillschweigend einen frischen Kaffee über den Tresen, den er eigentlich für sich gemacht hatte."
    user "He silently pushed a fresh coffee across the counter, one he had actually made for himself."

# game/story_main_05.rpy:103
translate english act5_daydreaming_and_decision_51fcc962:

    # m "\"Reboot. Wir brauchen dich.\""
    m "\"Reboot. We need you.\""

# game/story_main_05.rpy:121
translate english act5_daydreaming_and_decision_fe826b5d:

    # user "Der Arbeitstag ging vorbei, aber das Gefühl blieb."
    user "The workday passed, but the feeling remained."

# game/story_main_05.rpy:123
translate english act5_daydreaming_and_decision_48bd0099:

    # user "Jetzt lag ich in meinem Bett. Das Zimmer war dunkel, nur der Mond schien durch das Fenster."
    user "Now I was lying in my bed. The room was dark, only the moon shone through the window."

# game/story_main_05.rpy:125
translate english act5_daydreaming_and_decision_cd5f9dd7:

    # user "Ich starrte an die Decke und ließ den Tag Revue passieren."
    user "I stared at the ceiling and reviewed the day."

# game/story_main_05.rpy:127
translate english act5_daydreaming_and_decision_f048acaa:

    # user "Dass die Person heute nach mir gesehen hat... das hat mir mehr bedeutet, als ich zugeben wollte."
    user "That this person checked on me today... that meant more to me than I wanted to admit."

# game/story_main_05.rpy:129
translate english act5_daydreaming_and_decision_40fc9e31:

    # user "Ich drehte mich auf die Seite und schloss die Augen."
    user "I rolled onto my side and closed my eyes."

# game/story_main_05.rpy:131
translate english act5_daydreaming_and_decision_841cf621:

    # user "Es hat keinen Sinn mehr, es zu leugnen. Ich habe mich in dieses Café verliebt. In das Chaos. In die Arbeit."
    user "There's no point in denying it anymore. I've fallen in love with this café. With the chaos. With the work."

# game/story_main_05.rpy:133
translate english act5_daydreaming_and_decision_72d0c81f:

    # user "Aber vor allem in eine Person."
    user "But most of all, with a person."

# game/story_main_05.rpy:135
translate english act5_daydreaming_and_decision_18974fd3:

    # user "Mein Herz klopfte schneller, als ich mir endlich eingestand, wer mir wirklich nicht mehr aus dem Kopf geht."
    user "My heart beat faster as I finally admitted to myself who I really can't get out of my head anymore."

# game/story_main_05.rpy:151
translate english act5_daydreaming_and_decision_72899a9f:

    # user "Hinter seiner rauen Schale steckt jemand, der sich kümmert. Ich will diejenige sein, die ihn zum Lächeln bringt."
    user "Behind his rough exterior is someone who cares. I want to be the one who makes him smile."

# game/story_main_05.rpy:157
translate english act5_daydreaming_and_decision_6d4387e4:

    # user "Seine Ruhe ist genau das, was ich brauche. Bei ihm fühlt sich die Welt nicht so laut an."
    user "His calmness is exactly what I need. With him, the world doesn't feel so loud."

# game/story_main_05.rpy:163
translate english act5_daydreaming_and_decision_74e1bcb6:

    # user "Sie fordert mich heraus, aber sie sieht mich auch. Wirklich mich. Ich will an ihrer Seite glänzen."
    user "She challenges me, but she also sees me. Truly me. I want to shine by her side."

# game/story_main_05.rpy:170
translate english act5_daydreaming_and_decision_682ec6b2:

    # user "Er ist mein Sonnenschein. Mit ihm wird jeder Tag zu einem Abenteuer. Ich will dieses Lachen nie verlieren."
    user "He is my sunshine. With him, every day becomes an adventure. I never want to lose that laugh."

# game/story_main_05.rpy:176
translate english act5_daydreaming_and_decision_f4d08306:

    # user "Im Moment möchte ich mich einfach auf das Café konzentrieren..."
    user "Right now, I just want to focus on the café..."

